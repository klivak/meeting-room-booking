#!/bin/sh
# Runs on the files this commit actually touches, not on the whole tree: a
# pre-commit hook that takes ten seconds is a pre-commit hook people disable.
#
# Formatting and lint only. Types and tests are `npm run verify`, which is a
# minute of work and belongs to the end of a stage rather than to every commit.
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# Prettier understands more than it lints: json, css and markdown are in here
# too, and --ignore-unknown skips whatever it does not.
echo "$staged" | xargs npx prettier --check --ignore-unknown

code=$(echo "$staged" | grep -E '\.(ts|tsx|js|jsx|mjs)$' || true)
[ -n "$code" ] && echo "$code" | xargs npx eslint --max-warnings 0

exit 0
