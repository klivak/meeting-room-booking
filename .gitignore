# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright: browser output, not source
/e2e/.auth/
/e2e/screenshots/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/.next-test/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local working notes and agent tooling, not part of the deliverable
/.claude
/skills-lock.json

# Lighthouse output: generated on demand, never part of the deliverable
/lighthouse-report/

# Remotion renders are reproducible and too large for the repository.
/marketing/node_modules/
/marketing/out/
/marketing/public/app/*.png
