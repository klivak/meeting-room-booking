// Prisma schema for the meeting room booking app.
// All DateTime values are stored in UTC; conversion to the office timezone
// (Europe/Kyiv) or to the user's browser timezone happens in application code.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  // Stored already normalized (trim + lowercase), so the unique index
  // rejects "Ivan@X.com" when "ivan@x.com" is taken.
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  // Null until the address is confirmed; booking is closed until then.
  emailVerifiedAt DateTime?

  sessions           Session[]
  bookings           Booking[]
  bookingSeries      BookingSeries[]
  notifications      Notification[]
  verificationTokens VerificationToken[]
}

// Single-use secret from the confirmation link. In development the link is
// printed to the server log instead of being emailed.
model VerificationToken {
  token     String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // Issuing a link sweeps away everyone's expired tokens, and that sweep has
  // nothing but this index to find them by.
  @@index([expiresAt])
}

// Server-side session: the cookie only carries this row's id, so logout
// is a row delete and a session survives a page reload.
model Session {
  // No cuid() default on purpose: a cuid is a timestamp, a counter and only a
  // few random characters, and this id IS the credential. createSession fills
  // it from the system CSPRNG instead, so guessing one is hopeless even if the
  // signing secret ever leaked.
  id        String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // Signing in sweeps away expired sessions; without this the sweep would read
  // every row in the table to find them.
  @@index([expiresAt])
}

model Room {
  id       String @id @default(cuid())
  name     String @unique
  floor    Int
  capacity Int

  bookings Booking[]
}

// In-app warning that the room is needed the moment a booking ends.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  bookingId String
  type      String
  createdAt DateTime @default(now())
  readAt    DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // The guarantee that one booking warns its author exactly once: a second
  // attempt to create the same row is rejected by the database, not by a check
  // that two requests could pass at the same time.
  @@unique([bookingId, type])
  @@index([userId, readAt])
}

// Groups the occurrences of a weekly repetition. It carries no rule of its own:
// the occurrences hold their own times, and the series only says they belong
// together so one of them can be cancelled without the rest.
model BookingSeries {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]
}

model Booking {
  id       String  @id @default(cuid())
  roomId   String
  userId   String
  seriesId String?
  title    String
  // Half-open interval [startsAt, endsAt) in UTC.
  startsAt DateTime
  endsAt   DateTime
  // Soft delete: a canceled booking is hidden everywhere and is skipped
  // by overlap checks, so it stops blocking its slot.
  canceledAt DateTime?
  createdAt  DateTime  @default(now())

  room          Room           @relation(fields: [roomId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  series        BookingSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  notifications Notification[]

  // Week view of a room and the "my bookings" list are the only read paths.
  @@index([roomId, startsAt])
  // The "my bookings" list splits on endsAt and orders by startsAt, so the
  // filter columns come first and the sort column last. Without canceledAt and
  // endsAt in here, every page read the user's whole history to throw most of
  // it away.
  @@index([userId, canceledAt, endsAt, startsAt])
  // Cancelling a series updates all of its occurrences in one updateMany
  // filtered by seriesId, which had nothing to read but the whole table.
  @@index([seriesId])
}
