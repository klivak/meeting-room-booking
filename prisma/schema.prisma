// Prisma schema for the meeting room booking app.
// All DateTime values are stored in UTC; conversion to the office timezone
// (Europe/Kyiv) or to the user's browser timezone happens in application code.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  // Stored already normalized (trim + lowercase), so the unique index
  // rejects "Ivan@X.com" when "ivan@x.com" is taken.
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  // Null until the address is confirmed; booking is closed until then.
  emailVerifiedAt DateTime?

  sessions           Session[]
  bookings           Booking[]
  notifications      Notification[]
  verificationTokens VerificationToken[]
}

// Single-use secret from the confirmation link. In development the link is
// printed to the server log instead of being emailed.
model VerificationToken {
  token     String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Server-side session: the cookie only carries this row's id, so logout
// is a row delete and a session survives a page reload.
model Session {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Room {
  id       String @id @default(cuid())
  name     String @unique
  floor    Int
  capacity Int

  bookings Booking[]
}

// In-app warning that the room is needed the moment a booking ends.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  bookingId String
  type      String
  createdAt DateTime @default(now())
  readAt    DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // The guarantee that one booking warns its author exactly once: a second
  // attempt to create the same row is rejected by the database, not by a check
  // that two requests could pass at the same time.
  @@unique([bookingId, type])
  @@index([userId, readAt])
}

model Booking {
  id       String @id @default(cuid())
  roomId   String
  userId   String
  title    String
  // Half-open interval [startsAt, endsAt) in UTC.
  startsAt DateTime
  endsAt   DateTime
  // Soft delete: a canceled booking is hidden everywhere and is skipped
  // by overlap checks, so it stops blocking its slot.
  canceledAt DateTime?
  createdAt  DateTime  @default(now())

  room          Room           @relation(fields: [roomId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  notifications Notification[]

  // Week view of a room and the "my bookings" list are the only read paths.
  @@index([roomId, startsAt])
  @@index([userId, startsAt])
}
