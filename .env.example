# Copy this file to .env before running the app: cp .env.example .env
# The default values match the postgres service in docker-compose.yml.

# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meeting_room_booking?schema=public"

# Secret for signing the session cookie. Use a long random string in production.
SESSION_SECRET="dev-secret-change-me-in-production"

# First day of the week in the schedule grid: 1 = Monday ... 7 = Sunday.
NEXT_PUBLIC_WEEK_START_DAY=1

# Show a button on the sign-in screen that fills in the seeded demo account (see README).
# Convenient while reviewing the project; leave it off anywhere real.
NEXT_PUBLIC_DEMO_LOGIN=true

# How many minutes before a booking ends its author gets the "room is taken next" notification.
NOTIFY_BEFORE_MINUTES=10

# Set to true only when a reverse proxy in front of the app rewrites X-Forwarded-For.
# With nothing in front, that header is written by the caller, and trusting it would
# let anyone reset the login attempt counter on every request.
TRUST_PROXY=false
